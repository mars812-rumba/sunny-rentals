@app.get(API_PREFIX + "/crm/stats", dependencies=[Depends(crm_admin_required)])
def get_crm_stats(period: str = Query("week", alias="period")):
    """Получить статистику за период"""
    try:
        if not USER_DATA_JSON.exists():
            return {"status": "ok", "stats": {"total_users": 0, "in_progress": 0, "warm": 0, "hot": 0, "confirmed": 0}}

        with open(USER_DATA_JSON, "r", encoding="utf-8") as f:
            users_data = json.load(f)
        
        # Группируем по user_id
        unique_users = {}
        for user in users_data:
            uid = user.get("user_id")
            if uid:
                if uid not in unique_users or unique_users[uid].get("timestamp", "") < user.get("timestamp", ""):
                    unique_users[uid] = user

        # Фильтр по периоду
        period_users = filter_by_period(list(unique_users.values()), period)

        stats = {
                    "total_users": len(period_users),
                    "in_progress": len([u for u in period_users if u.get('final_status') == 'in_progress']),
                    "warm": len([u for u in period_users if u.get('final_status') == 'awaiting_followup']),
                    "hot": len([u for u in period_users if u.get('final_status') == 'booked' or u.get('booking_submitted') == True]),
                    "confirmed": len([u for u in period_users if u.get('final_status') == 'confirmed']),
                    "completed": len([u for u in period_users if u.get('final_status') == 'completed']),
                }
        
        # Считаем архив
        archive_count = 0
        if ARCHIVE_JSON.exists():
            try:
                with open(ARCHIVE_JSON, "r", encoding="utf-8") as f:
                    archive_data = json.load(f)
                    archive_users = filter_by_period(archive_data, period)
                    archive_count = len(archive_users)
            except:
                pass
        
        stats["archive"] = archive_count
        
        return {
            "status": "ok",
            "stats": stats
        }
    except Exception as e:
        print(f"❌ Error in get_crm_stats: {e}")
        raise HTTPException(status_code=500, detail=str(e))

